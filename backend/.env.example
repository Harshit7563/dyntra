PORT=5001
DATABASE_URL=postgresql://dyntra:dyntra123@localhost:5432/dyntra
JWT_SECRET=change-this-in-production

# Frontend URL (password reset links, payment callbacks)
FRONTEND_URL=http://localhost:3000

# Company contact email
COMPANY_EMAIL=dynatradex@gmail.com

# EmailJS (preferred) — templates from https://dashboard.emailjs.com
# Account → API keys → Public Key (+ Private Key for server)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
EMAILJS_ORDER_TEMPLATE_ID=template_xxxxxxx
# Welcome email on signup
EMAILJS_WELCOME_TEMPLATE_ID=template_xxxxxxx
# Optional separate admin new-order template
# EMAILJS_ADMIN_ORDER_TEMPLATE_ID=template_yyyyyyy

# Gmail SMTP fallback (if EmailJS not set)
SMTP_USER=dynatradex@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Dyntra <dynatradex@gmail.com>

# Payment webhook security (optional but recommended)
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# WhatsApp admin alerts via CallMeBot (optional)
# Register at https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_BOT_APIKEY=
WHATSAPP_ADMIN_PHONE=919137382475

# Shop with AI — free on-server stylist (no OpenAI key)
# On cPanel/live: uses PostgreSQL products automatically
# On local Mac (optional): pull catalog from live store
# USE_LIVE_CATALOG=true
# CATALOG_API_BASE=https://dyntra.in
